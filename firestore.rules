rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents
    match /users/{userId} {
      // Users can only read their own document
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        request.auth.token.email == resource.data.email
      );

      // Users can create their own profile document, but cannot inject or fabricate a subscription
      allow create: if request.auth != null && request.auth.uid == userId
                    && (!('subscription' in request.resource.data));

      // Users can update their profile information, but CANNOT modify or alter subscription fields
      allow update: if request.auth != null && request.auth.uid == userId
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription', 'role', 'isAdmin']));

      // Users can delete their own account profile
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
